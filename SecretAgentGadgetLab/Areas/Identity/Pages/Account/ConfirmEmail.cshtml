@page
@model ConfirmEmailModel
@{
    ViewData["Title"] = Model.Succeeded ? "Email confirmed" : "Confirmation failed";
}
<div class="login-wrapper">
    <div class="login-card" style="max-width:520px;margin:0 auto;">
        <div class="login-section-label">&#9658; Clearance</div>
        <h1 class="login-section-title">@ViewData["Title"]</h1>
        <p class="login-section-sub">@Model.StatusMessage</p>
        <div class="login-divider"></div>
        <a class="login-btn-primary" asp-page="./Login" style="display:inline-block;text-align:center;text-decoration:none;">
            &#9658; Back to sign in
        </a>
    </div>
</div>
