@page
@model TwoFactorAuthenticationModel
@{
    ViewData["Title"] = "Two-factor authentication (2FA)";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<div class="manage-section-label">&#9658; Two-factor authentication (2FA)</div>
<partial name="_StatusMessage" for="StatusMessage" />
@if (Model.Is2faEnabled)
{
    <div class="manage-2fa-status manage-2fa-active">
        <span class="manage-2fa-dot"></span> 2FA is active on this account
    </div>
}
else
{
    <div class="manage-2fa-status manage-2fa-inactive">
        <span class="manage-2fa-dot"></span> 2FA is not enabled
    </div>
}
<div class="manage-subsection">
    <h3 class="manage-subsection-title">&#9658; Authenticator app</h3>
    <div class="manage-2fa-btn-group">
        @if (!Model.HasAuthenticator)
        {
            <a asp-page="./EnableAuthenticator" class="manage-btn-primary">&#9658; Set up authenticator app</a>
        }
        else
        {
            <a asp-page="./EnableAuthenticator" class="manage-btn-primary">&#9658; Set up authenticator app</a>
            <a asp-page="./ResetAuthenticator" class="manage-btn-secondary">&#9658; Reset authenticator app</a>
        }
    </div>
</div>
@if (Model.Is2faEnabled)
{
    <div class="manage-subsection">
        @if (Model.RecoveryCodesLeft == 0)
        {
            <div class="manage-warning-box">
                <strong>&#9888; You have no recovery codes left.</strong>
                <p>You must <a asp-page="./GenerateRecoveryCodes">generate a new set of recovery codes</a> before you can log in with a recovery code.</p>
            </div>
        }
        else if (Model.RecoveryCodesLeft == 1)
        {
            <div class="manage-warning-box">
                <strong>&#9888; You have 1 recovery code left.</strong>
                <p>You can <a asp-page="./GenerateRecoveryCodes">generate a new set of recovery codes</a>.</p>
            </div>
        }
        else if (Model.RecoveryCodesLeft <= 3)
        {
            <div class="manage-warning-box">
                <strong>&#9888; You have @Model.RecoveryCodesLeft recovery codes left.</strong>
                <p>You should <a asp-page="./GenerateRecoveryCodes">generate a new set of recovery codes</a>.</p>
            </div>
        }
        <div class="manage-2fa-btn-group">
            @if (Model.IsMachineRemembered)
            {
                <form method="post">
                    <button type="submit" class="manage-btn-secondary">&#9658; Forget this browser</button>
                </form>
            }
            <a asp-page="./GenerateRecoveryCodes" class="manage-btn-secondary">&#9658; Generate recovery codes</a>
            <a asp-page="./Disable2fa" class="manage-btn-danger">&#9658; Disable 2FA</a>
        </div>
    </div>
}
