@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Change password";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<div class="manage-section-label">&#9658; Change password</div>
<partial name="_StatusMessage" for="StatusMessage" />
<form id="change-password-form" method="post" class="manage-form">
    <div asp-validation-summary="ModelOnly" class="manage-error-box text-danger" role="alert"></div>
    <div class="manage-field">
        <label class="manage-field-label" asp-for="Input.OldPassword">&#9658; Current password</label>
        <input asp-for="Input.OldPassword" class="manage-input" autocomplete="current-password" placeholder="Enter the old password" />
        <span asp-validation-for="Input.OldPassword" class="text-danger"></span>
    </div>
    <div class="manage-field">
        <label class="manage-field-label" asp-for="Input.NewPassword">&#9658; New password</label>
        <input asp-for="Input.NewPassword" class="manage-input" autocomplete="new-password" placeholder="Enter the new password" />
        <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
    </div>
    <div class="manage-field">
        <label class="manage-field-label" asp-for="Input.ConfirmPassword">&#9658; Confirm new password</label>
        <input asp-for="Input.ConfirmPassword" class="manage-input" autocomplete="new-password" placeholder="Enter the new password" />
        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
    </div>
    <button type="submit" class="manage-btn-primary">&#9658; Update password</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
