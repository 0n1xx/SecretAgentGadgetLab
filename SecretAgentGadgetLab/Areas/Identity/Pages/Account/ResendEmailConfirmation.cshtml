@page
@model ResendEmailConfirmationModel
@{
    ViewData["Title"] = "Resend confirmation";
}
<div class="login-wrapper">
    <div class="login-card" style="max-width:520px;margin:0 auto;">
        <div class="login-section-label">&#9658; Resend link</div>
        <h1 class="login-section-title">Resend confirmation</h1>
        <p class="login-section-sub">Enter your email and we'll send a new confirmation link.</p>
        <div class="login-divider"></div>
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="login-error-box text-danger" role="alert"></div>
            <div class="login-field">
                <label class="login-field-label" asp-for="Input.Email">&#9658; Email</label>
                <input asp-for="Input.Email" autocomplete="username" aria-required="true" placeholder="agent@classified.gov" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <button type="submit" class="login-btn-primary">&#9658; Send link</button>
        </form>
        <div class="login-links">
            <a asp-page="./Login">Back to sign in</a>
        </div>
    </div>
</div>
