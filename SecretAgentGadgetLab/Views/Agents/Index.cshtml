@model IEnumerable<SecretAgentGadgetLab.Models.Agent>

@{
    ViewData["Title"] = "Agents";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Agents</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table table-striped table-hover shadow-sm"> <!-- https://getbootstrap.com/docs/5.3/utilities/shadows/  added just for the small shadow effect -->
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.CodeName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CountryCode)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Salary)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.CodeName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CountryCode)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Salary)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
