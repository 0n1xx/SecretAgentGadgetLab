@model SecretAgentGadgetLab.Models.Agent

@{
    ViewData["Title"] = "Delete Agent";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<!-- Used Claude (Anthropic) to help generate the base wrapper/container structure (outer wrapper div with header, body, and action divs inside) which was then reused across multiple views in the project
     (https://claude.ai) -->
<div class="delete-wrapper">
    <div class="delete-header">
        <div>
            <p class="delete-header-label">Admin Panel / Danger Zone</p>
            <h1 class="delete-header-title">Delete Agent</h1>
        </div>
    </div>
    <div class="delete-warning">
        <span class="delete-warning-icon">⚠️</span>
        This action is permanent and cannot be undone.
    </div>
    <div class="delete-card">
        <div class="delete-card-header">
            <i class="bi bi-person-badge"></i>
            <p class="delete-card-header-label">Agent Record</p>
        </div>
        <div class="delete-card-body">
            <div class="delete-row">
                <span class="delete-row-label">Code Name</span>
                <span class="delete-row-value">@Model.CodeName</span>
            </div>
            <hr class="delete-row-divider" />
            <div class="delete-row">
                <span class="delete-row-label">Country</span>
                <span class="delete-row-value">@Model.CountryCode</span>
            </div>
            <hr class="delete-row-divider" />
            <div class="delete-row">
                <span class="delete-row-label">Salary</span>
                <span class="delete-row-value delete-row-value--accent">$@Model.Salary.ToString("N0")</span>
            </div>
        </div>
    </div>
    <div class="delete-actions">
        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn-delete">Confirm Delete</button>
        </form>
        <a asp-action="Index" class="btn btn-outline-lime">← Back to List</a>
    </div>
</div>
