@model SecretAgentGadgetLab.Models.Agent

@{
    ViewData["Title"] = "Edit Agent";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="edit-wrapper">

    <div class="edit-header">
        <div>
            <p class="edit-header-label">Admin Panel</p>
            <h1 class="edit-header-title">Edit Agent</h1>
        </div>
    </div>

    <div class="edit-card">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="Id" />

            <div class="edit-field">
                <p class="edit-section-label">Field / Identity</p>
                <label asp-for="CodeName">Code Name</label>
                <input asp-for="CodeName" placeholder="e.g. Shadow Fox" />
                <span asp-validation-for="CodeName" class="text-danger"></span>
            </div>

            <hr class="edit-divider" />

            <div class="edit-field">
                <p class="edit-section-label">Field / Origin</p>
                <label asp-for="CountryCode">Country</label>
                <select asp-for="CountryCode">
                    <option value="">— Select Country —</option>
                    <option value="CA">Canada</option>
                    <option value="RU">Russia</option>
                    <option value="BY">Belarus</option>
                    <option value="FR">France</option>
                </select>
                <span asp-validation-for="CountryCode" class="text-danger"></span>
            </div>

            <hr class="edit-divider" />

            <div class="edit-field">
                <p class="edit-section-label">Field / Compensation</p>
                <label asp-for="Salary">Salary (USD)</label>
                <input asp-for="Salary" placeholder="e.g. 75000" />
                <span asp-validation-for="Salary" class="text-danger"></span>
            </div>

            <hr class="edit-divider" />

            <div class="edit-actions">
                <button type="submit" class="btn-save">Save Changes</button>
                <a asp-action="Index" class="btn btn-outline-lime">← Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}