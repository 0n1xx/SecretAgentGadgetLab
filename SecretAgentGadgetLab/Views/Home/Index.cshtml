@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

@{
    ViewData["Title"] = "Home Page";
}
<!-- Used Claude (Anthropic) to help generate the base wrapper/container structure (outer wrapper div with header, body, and action divs inside) which was then reused across multiple views in the project. 
     (https://claude.ai) -->
<div class="home-main-container">

    <div class="home-label">▶ CLASSIFIED SYSTEM</div>
    <h1 class="home-title">SecretAgentGadgetLab</h1>
    <p class="home-sub" style="margin-bottom: 1rem;">Demo spy-gadget shop · ASP.NET portfolio project</p>

    <div class="home-divider"></div>

    @* Plain-language purpose for Google OAuth branding verification (must be visible without login). *@
    <div class="home-purpose">
        <p>
            <strong>SecretAgentGadgetLab</strong> is a demo online shop and learning project built with ASP.NET.
            Visitors can browse fictional spy-themed gadgets, create an account, manage a cart, and place demo orders.
        </p>
        <p>
            Google Sign-In is used only to authenticate your shop account (email and display name).
            SecretAgentGadgetLab does not use Google APIs for AI-generated non-consensual intimate imagery (AI NCII).
            See our
            <a href="https://secretagentlab.store/Home/Privacy">Privacy Policy</a>,
            <a asp-controller="Home" asp-action="AppHome">App info</a>,
            and
            <a asp-controller="Home" asp-action="About">About</a>
            pages.
        </p>
    </div>

    @if (SignInManager.IsSignedIn(User))
    {
        <p class="home-sub">Identity confirmed. You are cleared for access, agent.</p>
        <a asp-controller="Shop" asp-action="Index" class="btn btn-primary home-btn">▶ Enter the Shop</a>
    }
    else
    {
        <!-- Displaying a message for a user that before using our website, he needs to log in -->
        <p class="home-sub">
            Access to the Shop is classified. 🕵♂️<br />
            If you're seeing this, you're not cleared yet.<br />
            Register (or log in) to prove you're not just a random civilian… or worse, a double Belorussian agent. 😏
        </p>
        <div class="home-actions">
            <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-primary home-btn">▶ Login</a>
            <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-outline-lime home-btn">Register</a>
        </div>
    }
    <!-- Added some interactivity for users to understand how secret our platform is :) -->
    <div class="home-stats">
        <div class="home-stat-card">
            <span class="home-stat-label">▶ STATUS</span>
            <span class="home-stat-value">ACTIVE</span>
        </div>
        <div class="home-stat-card">
            <span class="home-stat-label">▶ CLEARANCE</span>
            <span class="home-stat-value">@(SignInManager.IsSignedIn(User) ? "GRANTED" : "DENIED")</span>
        </div>
        <div class="home-stat-card">
            <span class="home-stat-label">▶ LOCATION</span>
            <span class="home-stat-value">CLASSIFIED</span>
        </div>
    </div>

</div>