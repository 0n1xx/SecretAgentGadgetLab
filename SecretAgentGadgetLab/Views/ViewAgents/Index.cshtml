@model IEnumerable<SecretAgentGadgetLab.Models.Agent>

@{
    ViewData["Title"] = "ViewAgents";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>ViewAgents</h1>
<!-- Only authenticated users can create, edit, or delete agents. This button is visible only for authenticated agents -->
@if (User.Identity.IsAuthenticated)
{
    <p>
        <a class="btn btn-primary" asp-action="Create">+ Create New</a>
    </p>
}

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.CodeName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CountryCode)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Salary)
            </th>

            @if (User.Identity.IsAuthenticated)
            {
                <th>Actions</th>
            }
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.CodeName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.CountryCode)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Salary)
                </td>
                <!-- Only authenticated users can view these buttons -->
                @if (User.Identity.IsAuthenticated)
                {
                    <td>
                        <a class="btn btn-sm btn-primary"
                               asp-action="Edit"
                               asp-route-id="@item.Id">
                            Edit
                        </a>

                        <a class="btn btn-sm btn-danger"
                               asp-action="Delete"
                               asp-route-id="@item.Id">
                            Delete
                        </a>

                        <a class="btn btn-sm btn-secondary"
                               asp-action="Details"
                               asp-route-id="@item.Id">
                            Details
                        </a>
                    </td>
                }
            </tr>
        }
    </tbody>
</table>