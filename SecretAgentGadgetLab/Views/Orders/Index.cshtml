@model IEnumerable<SecretAgentGadgetLab.Models.Order>
@{
    ViewData["Title"] = "Order History";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container orders-main-container">
    <div class="orders-header">
        <div>
            <p class="orders-header-label">Mission Archive</p>
            <h1 class="orders-header-title">Order History</h1>
        </div>
        @if (User.IsInRole("Administrator"))
        {
            <a asp-action="Create" class="btn btn-primary ms-auto">+ Create New</a>
        }
    </div>
    @if (!Model.Any())
    {
        <div class="orders-empty">
            <p>No orders found, Agent.</p>
            <a asp-controller="Shop" asp-action="Index" class="btn btn-primary mt-2">Browse Gadgets</a>
        </div>
    }
    else
    {
        <div class="orders-table-wrapper">
            <table class="table cart-table">
                <thead>
                    <tr>
                        <th>ORDER #</th>
                        <th>DATE</th>
                        <th>NAME</th>
                        @if (User.IsInRole("Administrator"))
                        {
                            <th>CUSTOMER</th>
                        }
                        <th>TOTAL</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="cart-gadget-name">#@item.OrderId</td>
                            <td class="cart-date">@item.OrderDate.ToString("MMM dd, yyyy")</td>
                            <td>@item.FirstName @item.LastName</td>
                            @if (User.IsInRole("Administrator"))
                            {
                                <td class="cart-date">@item.CustomerId</td>
                            }
                            <td class="cart-subtotal">@String.Format("${0:N2}", item.OrderTotal)</td>
                            <td>
                                <a asp-action="Details" asp-route-id="@item.OrderId" class="orders-action-btn">Details</a>
                                @if (User.IsInRole("Administrator"))
                                {
                                    <span class="orders-divider">|</span>
                                    <a asp-action="Edit" asp-route-id="@item.OrderId" class="orders-action-btn">Edit</a>
                                    <span class="orders-divider">|</span>
                                    <a asp-action="Delete" asp-route-id="@item.OrderId" class="cart-delete-btn">Delete</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>