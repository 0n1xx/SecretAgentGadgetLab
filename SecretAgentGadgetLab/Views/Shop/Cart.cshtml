@model IEnumerable<SecretAgentGadgetLab.Models.Cart>
@{
    ViewData["Title"] = "Cart";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container cart-wrapper">

    <div class="cart-header">
        <span class="cart-header-icon">🛒</span>
        <div>
            <p class="cart-header-label">Mission Loadout</p>
            <h1 class="cart-header-title">Your Cart</h1>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="cart-empty">
            <span style="font-size: 3rem;">📦</span>
            <p class="mt-3">Your cart is empty, agent.</p>
            <a asp-controller="Shop" asp-action="Index" class="btn btn-primary mt-2">Browse Gadgets</a>
        </div>
    }
    else
    {
        <div class="cart-table-wrapper">
            <table class="table cart-table">
                <thead>
                    <tr>
                        <th>▶ GADGET</th>
                        <th>QTY</th>
                        <th>UNIT PRICE</th>
                        <th>SUBTOTAL</th>
                        <th>DATE</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="cart-gadget-name">@item.Gadget?.Name</td>
                            <td>@item.Quantity</td>
                            <td>@String.Format("{0:c}", item.Price)</td>
                            <td class="cart-subtotal">@String.Format("{0:c}", item.Price * item.Quantity)</td>
                            <td class="cart-date">@item.DateCreated.ToString("MMM dd, yyyy")</td>
                            <td>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="cart-delete-btn">✕ Remove</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="cart-footer">
            <div class="cart-total-box">
                <span class="cart-total-label">▶ TOTAL COST</span>
                <span class="cart-total-value">@String.Format("{0:c}", Model.Sum(i => i.Price * i.Quantity))</span>
            </div>
            <a asp-controller="Shop" asp-action="Index" class="btn btn-outline-lime">← Continue Shopping</a>
        </div>
    }

</div>
