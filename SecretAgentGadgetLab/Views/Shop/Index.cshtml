@model IEnumerable<SecretAgentGadgetLab.Models.Agent>
@{
    ViewData["Title"] = "Browse Gadgets by Agents";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<!-- Used Claude (Anthropic) to help generate the base wrapper/container structure (outer wrapper div with header, body, and action divs inside) which was then reused across multiple views in the project.
     (https://claude.ai) -->
<div class="agents-main-container">
    <p class="agents-header-label">▶ OPERATIVE ROSTER</p>
    <h1 class="agents-header-title">Choose an Agent</h1>
    <!-- Displaying every agent that is in my secret system :) -->
    <section class="agents-grid">
        @foreach (var agent in Model)
        {
            <div class="agent-card">
                <div class="agent-card-top">
                    <span class="agent-badge">ACTIVE</span>
                </div>
                <h5 class="agent-name">@agent.CodeName</h5>
                <div class="agent-meta">
                    <span class="agent-meta-label">▶ COUNTRY</span>
                    <span class="agent-meta-value">@agent.CountryCode</span>
                </div>
                <a asp-action="Browse" asp-route-agentId="@agent.Id" class="btn btn-primary agent-btn">
                    View Gadgets →
                </a>
            </div>
        }
    </section>

</div>
