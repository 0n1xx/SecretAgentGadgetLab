@model IEnumerable<SecretAgentGadgetLab.Models.Gadget>

@{
    ViewData["Title"] = "Gadgets";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<!-- Used Claude (Anthropic) to help generate the base wrapper/container structure (outer wrapper div with header, body, and action divs inside) which was then reused across multiple views in the project
     (https://claude.ai) -->
<div class="gadgets-wrapper">
    <div class="gadgets-header">
        <div>
            <p class="gadgets-header-label">Admin Panel</p>
            <h1 class="gadgets-header-title">Gadgets</h1>
        </div>
        <a asp-action="Create" class="btn-save">+ Create New</a>
    </div>
    <!-- Displaying the following div if there are no gadgets -->
    @if (!Model.Any())
    {
        <div class="gadgets-empty">
            <p style="font-size:2rem;">📦</p>
            <p style="color:#6b7280;">No gadgets found. Create one to get started.</p>
        </div>
    }
    else
    {
        <div class="gadgets-table-wrap">
            <table class="table gadgets-table">
                <thead>
                    <!-- Setting the column names -->
                    <tr>
                        <th>Photo</th>
                        <th>@Html.DisplayNameFor(model => model.Name)</th>
                        <th>@Html.DisplayNameFor(model => model.Description)</th>
                        <th>@Html.DisplayNameFor(model => model.Price)</th>
                        <th>@Html.DisplayNameFor(model => model.Agent)</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Displaying every gadget from my table -->
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="gadgets-td-photo">
                                @if (item.Photo != null)
                                {
                                    <img src="@item.Photo" alt="@item.Name" class="gadgets-thumb" />
                                }
                                else
                                {
                                    <div class="gadgets-thumb-placeholder">📦</div> <!-- I tried using different stickers, I hope they look cool and appropriate here -->
                                }
                            </td>
                            <td class="gadgets-td-name">@item.Name</td>
                            <td class="gadgets-td-desc">@item.Description</td>
                            <td class="gadgets-td-price">$@item.Price.ToString("N2")</td>
                            <td>@item.Agent?.CodeName</td>
                            <td>
                                <div class="gadgets-actions">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="gadgets-action-btn gadgets-action-edit">Edit</a>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="gadgets-action-btn gadgets-action-details">Details</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="gadgets-action-btn gadgets-action-delete">Delete</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>