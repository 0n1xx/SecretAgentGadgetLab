@model SecretAgentGadgetLab.Models.Gadget

@{
    ViewData["Title"] = "Delete Gadget";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="delete-wrapper">

    <div class="delete-header">
        <div>
            <p class="delete-header-label">Admin Panel / Danger Zone</p>
            <h1 class="delete-header-title">Delete Gadget</h1>
        </div>
    </div>

    <div class="delete-warning">
        <span class="delete-warning-icon">⚠️</span>
        This action is permanent and cannot be undone.
    </div>

    <div class="delete-card">
        <div class="delete-card-header">
            <i class="bi bi-box-seam"></i>
            <p class="delete-card-header-label">Gadget Record</p>
        </div>

        <div class="delete-card-body">

            @if (!string.IsNullOrEmpty(Model.Photo))
            {
                <div class="delete-gadget-photo-wrap">
                    <img src="~/img/@Model.Photo" alt="@Model.Name" class="delete-gadget-photo" />
                </div>
            }

            <div class="delete-row">
                <span class="delete-row-label">Name</span>
                <span class="delete-row-value">@Model.Name</span>
            </div>
            <hr class="delete-row-divider" />

            <div class="delete-row">
                <span class="delete-row-label">Description</span>
                <span class="delete-row-value">@Model.Description</span>
            </div>
            <hr class="delete-row-divider" />

            <div class="delete-row">
                <span class="delete-row-label">Price</span>
                <span class="delete-row-value delete-row-value--accent">$@Model.Price.ToString("N2")</span>
            </div>
            <hr class="delete-row-divider" />

            <div class="delete-row">
                <span class="delete-row-label">Assigned Agent</span>
                <span class="delete-row-value">@Model.Agent?.CodeName</span>
            </div>

        </div>
    </div>

    <div class="delete-actions">
        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn-delete">Confirm Delete</button>
        </form>
        <a asp-action="Index" class="btn btn-outline-lime">← Back to List</a>
    </div>

</div>