@model SecretAgentGadgetLab.Models.Gadget

@{
    ViewData["Title"] = "Edit Gadget";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<!-- Used Claude (Anthropic) to help generate the base wrapper/container structure (outer wrapper div with header, body, and action divs inside) which was then reused across multiple views in the project
     (https://claude.ai) -->
<div class="edit-wrapper">
    <div class="edit-header">
        <div>
            <p class="edit-header-label">Admin Panel</p>
            <h1 class="edit-header-title">Edit Gadget</h1>
        </div>
    </div>
    <div class="edit-card">
        <form asp-action="Edit" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="Id" />
            <div class="edit-field">
                <p class="edit-section-label">Field / Identity</p>
                <label asp-for="Name">Gadget Name</label>
                <input asp-for="Name" placeholder="e.g. Exploding Pen" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <hr class="edit-divider" />
            <div class="edit-field">
                <p class="edit-section-label">Field / Details</p>
                <label asp-for="Description">Description</label>
                <input asp-for="Description" placeholder="e.g. Disguised as an ordinary pen..." />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <hr class="edit-divider" />
            <div class="edit-field">
                <p class="edit-section-label">Field / Pricing</p>
                <label asp-for="Price">Price (USD)</label>
                <input asp-for="Price" placeholder="e.g. 299.99" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>
            <hr class="edit-divider" />
            <div class="edit-field">
                <p class="edit-section-label">Field / Visual</p>
                <label for="Photo">Photo</label>
                @if (!string.IsNullOrEmpty(Model.Photo))
                {
                    <div class="mb-2">
                        <img src="@Model.Photo" alt="Current photo" style="max-height:120px; border-radius:6px;" />
                        <p class="text-muted" style="font-size:0.8rem; margin-top:4px;">Current photo — leave blank to keep it</p>
                    </div>
                }
                <input type="file" name="Photo" id="Photo" class="edit-file-input" />
            </div>
            <hr class="edit-divider" />
            <div class="edit-field">
                <p class="edit-section-label">Field / Assignment</p>
                <label asp-for="AgentId">Assigned Agent</label>
                <select asp-for="AgentId" asp-items="ViewBag.AgentId">
                    <option value="">— Select Agent —</option>
                </select>
                <span asp-validation-for="AgentId" class="text-danger"></span>
            </div>
            <hr class="edit-divider" />
            <div class="edit-actions">
                <button type="submit" class="btn-save">Save Changes</button>
                <a asp-action="Index" class="btn btn-outline-lime">← Back to List</a>
            </div>
        </form>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}